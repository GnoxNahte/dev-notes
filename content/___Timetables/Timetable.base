formulas:
  Untitled: file.basename.split("(")[0]
  Untitled 2: file.basename.split(/\(|\)/)[1]
  Sort days: (today() - "7d" - date("2026-" + file.basename.split(/\{|\}/)[1]) < 0)
  Days Left: today() - date("2026-" + file.basename.split(/\{|\}/)[1])
properties:
  formula.Untitled 2:
    displayName: Date
  formula.Untitled:
    displayName: Week Number
views:
  - type: cards
    name: Timetable
    filters:
      and:
        - file.inFolder("___Timetables/Images/Yr 1.3")
        - file.ext == "png"
    order:
      - formula.Untitled
      - formula.Untitled 2
      - formula.Days Left
    sort:
      - property: formula.Sort days
        direction: DESC
      - property: file.name
        direction: ASC
    image: file.file
    imageFit: contain
    cardSize: 500
