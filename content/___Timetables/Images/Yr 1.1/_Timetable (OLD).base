formulas:
  Untitled: file.basename.split("(")[0]
  "": date("2025-"+file.basename.split(/\(|\)/)[1].split(" to ")[0]).format("D MMM")
  Untitled 2: file.basename.split(/\(|\)/)[1]
  CurrWeek: file.basename.slice(-4, -1)
properties:
  formula.:
    displayName: Numbered date to display date
  formula.Untitled 2:
    displayName: Date
views:
  - type: cards
    name: Timetable
    filters:
      and:
        - file.inFolder("___Timetables/Images/Yr 1.1")
        - file.ext == "png"
    order:
      - formula.Untitled
      - formula.Untitled 2
    sort:
      - property: file.name
        direction: ASC
    image: file.file
    imageFit: contain
    cardSize: 500
