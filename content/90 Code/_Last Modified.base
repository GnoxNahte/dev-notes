formulas:
  Modified day: file.mtime.format("YYYY MM DD - DD MMM")
  Modified Time: file.mtime.format("DD MMM YYYY, hh:mm A")
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder(this.file.folder) && file.path != this.file.path
    groupBy:
      property: formula.Modified day
      direction: DESC
    order:
      - file.name
      - formula.Modified Time
      - formula.Created day
    sort:
      - property: file.mtime
        direction: DESC
