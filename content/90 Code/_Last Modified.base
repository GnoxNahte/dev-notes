formulas:
  Modified Time: file.mtime.format("DD MMM YYYY, hh:mm A")
  Modified day: '[html("<span style=\"display:none;\">" + file.mtime.format("YYYY-DD-MM")+ "</span>"), file.mtime.format("DD MMM YYYY")]'
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder(this.file.folder) && file.path != this.file.path
    groupBy:
      property: formula.Modified day
      direction: DESC
    order:
      - file.name
      - formula.Modified Time
    sort:
      - property: file.mtime
        direction: DESC
