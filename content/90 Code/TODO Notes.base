filters:
  and:
    - file.inFolder(this.file.folder) && file.path != this.file.path
    - file.ext == "md"
formulas:
  Created Time: file.ctime.format("DD MMM YYYY, hh:mm A")
  Modified Time: file.mtime.format("DD MMM YYYY, hh:mm A")
  Created day: file.ctime.format("YYYY MM DD - DD MMM")
  day: file.ctime.format("YYYY MM DD - DD MMM")
properties:
  formula.Created day:
    displayName: Modified day
  formula.day:
    displayName: Created day
views:
  - type: table
    name: TODO - Modified
    filters:
      and:
        - file.tags.contains("todo")
    groupBy:
      property: formula.Created day
      direction: DESC
    order:
      - file.name
      - formula.Modified Time
      - formula.Created dat
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      formula.Created Time: 160
  - type: table
    name: TODO - Created
    filters:
      and:
        - file.tags.contains("todo")
    groupBy:
      property: formula.day
      direction: DESC
    order:
      - file.name
      - formula.Created Time
    sort:
      - property: formula.day
        direction: DESC
    columnSize:
      formula.Created Time: 160
