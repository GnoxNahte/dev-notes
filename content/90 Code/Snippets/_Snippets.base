formulas:
  Language: if(file.path.contains("Languages"), file.path.split('/')[2], "Any Language")
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("90 Code") && file.folder.contains("Snippets") && file.path != this.file.path
    groupBy:
      property: formula.Language
      direction: ASC
    order:
      - file.name
      - file.ext
      - file.path
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
      - property: file.name
        direction: DESC
    columnSize:
      file.ext: 41
